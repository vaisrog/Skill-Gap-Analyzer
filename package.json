{
  "name": "skill-gap-analyzer-root",
  "private": true,
  "version": "1.0.0",
  "description": "Skill Gap Analyzer & Learning Roadmap",
  "scripts": {
    "dev": "concurrently \"npm --prefix frontend run dev\" \"python backend/app.py\"",
    "start": "concurrently \"npm --prefix frontend run dev\" \"python backend/app.py\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python backend/app.py",
    "build": "npm --prefix frontend run build",
    "install:all": "npm --prefix frontend install && python -m pip install -r backend/requirements.txt",
    "seed": "python backend/seed.py"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
